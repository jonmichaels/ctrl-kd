#!/usr/bin/env bash
# Commit messages leak too -- a path or a machine name in a message is as
# published as one in a file. Pattern shared via tools/private_patterns.sh.
set -uo pipefail
root="$(git rev-parse --show-toplevel)"
. "$root/tools/private_patterns.sh"
if grep -nE "$PAT" "$1"; then
  echo "BLOCKED: commit message carries private material (shown above). Reword." >&2
  exit 1
fi
exit 0
