#!/usr/bin/env bash
# Last line of defense: scan the ENTIRE outgoing range -- content, messages,
# and author/committer metadata. Pattern shared via tools/private_patterns.sh.
set -uo pipefail
root="$(git rev-parse --show-toplevel)"
. "$root/tools/private_patterns.sh"

fail=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "0000000000000000000000000000000000000000" ] && continue
  if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
    range="$local_sha"
  else
    range="$remote_sha..$local_sha"
  fi

  if git log "$range" --format='%B' | grep -qE "$PAT"; then
    echo "BLOCKED pre-push: private material in outgoing commit MESSAGES ($range)" >&2
    git log "$range" --format='%h %s' | head -5 >&2
    fail=1
  fi

  # Content, excluding the two files that carry the patterns by definition.
  if git log "$range" -p -- . \
        ':(exclude)tools/private_patterns.sh' \
        ':(exclude)tools/audit_private.sh' \
     | grep -E '^\+' | grep -qE "$PAT"; then
    echo "BLOCKED pre-push: private material in outgoing commit CONTENT ($range)" >&2
    git log "$range" -p -- . \
        ':(exclude)tools/private_patterns.sh' \
        ':(exclude)tools/audit_private.sh' \
      | grep -E '^\+' | grep -nE "$PAT" | head -5 >&2
    fail=1
  fi

  # Metadata. A hostname in an author field is as public as one in a file --
  # this check was added 2026-08-22 after `worker@<host>` reached 319 commits.
  if git log "$range" --format='%an|%ae|%cn|%ce' | grep -qE "$PAT"; then
    echo "BLOCKED pre-push: private material in AUTHOR/COMMITTER metadata ($range)" >&2
    git log "$range" --format='%h %ae %ce' | grep -E "$PAT" | head -5 >&2
    fail=1
  fi
done

# Whole-tree audit as well, so nothing already tracked slips out behind a
# clean incremental range.
if ! "$root/tools/audit_private.sh" >/dev/null 2>&1; then
  echo "BLOCKED pre-push: tools/audit_private.sh reports private material tracked." >&2
  "$root/tools/audit_private.sh" >&2
  fail=1
fi
exit $fail
